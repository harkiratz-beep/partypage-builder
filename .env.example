NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- server only, never NEXT_PUBLIC_ ---------------------------------------

# Required. Host reads/writes use this; guest traffic never does.
# Supabase dashboard → Project Settings → API keys → service_role.
# Bypasses RLS, so it must never be exposed to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for admin sign-in. There is NO default and never should be —
# this repo is public, so a committed fallback would be a published password.
# If unset, admin sign-in always fails and the server logs why.
HOST_PASSWORD=pick-something

# Optional usernames. Defaults: admin / guest.
# HOST_USERNAME=admin
# GUEST_USERNAME=guest

# Optional. Signs the session cookie. If unset, a key is derived from
# SUPABASE_SERVICE_ROLE_KEY, which is fine.
# SESSION_SECRET=a-long-random-string
